# Keep training data for CI (small files, needed by GitHub Actions)
!data/processed/train.parquet
!data/processed/test.parquet
!data/processed/aligned_pairs.parquet
!data/processed/all_pairs_v2.json
# Canonical oil-only split for the 2026 retraining study. Committed
# so every number in the writeup traces to a reproducible artifact.
!data/processed/canonical_oil/
!data/processed/canonical_oil/*.parquet
!data/processed/canonical_oil/*.json
# Live data managed by GitHub Actions (force-added in workflow).
# paper_trades*.jsonl covers both the legacy archive and per-UTC-day
# rotated files (task #27). Force-added in collect-and-trade workflow.
data/live/bars.parquet
data/live/active_matches.json
data/live/paper_trades*.jsonl
data/live/retrain_log.json
# Phase A shadow-mode predictions log (canonical-oil XGBoost). Grows
# per-cycle per-oil-pair (MBs/day expected). Off-tree by design.
data/live/canonical_predictions.jsonl
# Phase A.E1 realized P&L log — predictions enriched with next-bar
# outcomes. Same gitignore treatment as the shadow log.
data/live/canonical_realized.jsonl
# Phase 15 backup snapshots (pre-fix state; archived locally but
# not tracked — too large and the pre-fix state is already pinned
# in 15-01-DIAGNOSTIC.md probe evidence).
data/live/*.pre-phase15.json
data/pmxt/

# Generated / runtime output (TFT training artifacts, session scratch)
lightning_logs/
checkpoints/
graphify-out/
